# fogg-coach 后端配置（复制为 .env 使用；数值口径见 system-design §3.5）
PORT=8080
DEBUG=0

# JWT（生产必须换 32+ 字节随机串）
JWT_SECRET=dev-secret
JWT_TTL_DAYS=7

# LLM（OpenAI 兼容；M1 用 GLM，DeepSeek 备）
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-5.2

# 微信小程序（本地开发 WX_MOCK=1 时任意 code 可登）
WX_APPID=
WX_SECRET=
WX_MOCK=1

# 用户配额
QUOTA_DAILY_MESSAGES=50
QUOTA_SESSION_TURNS=25
QUOTA_MESSAGE_MAX_LEN=500
QUOTA_PLAN_GENERATIONS=3

# 行为特征检测
RATE_LIMIT_MSGS_PER_SEC=2
RATE_LIMIT_COOLDOWN_SEC=30
LONG_MSG_STREAK=3

# 全站 LLM 日耗硬顶（元，0=不限制）
GLOBAL_DAILY_COST_CAP=0
