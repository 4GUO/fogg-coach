# ===== fogg-coach 配置（全部限额可调，勿硬编码） =====

# --- 服务 ---
PORT=3210
JWT_SECRET=change-me-in-production

# --- LLM（GLM）---
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# --- 微信 ---
WX_APPID=
WX_SECRET=
# 开发模式：WX_MOCK=1 时任意 code 登录成功（openid=mock_<code>）
WX_MOCK=1

# --- 用户级配额 ---
QUOTA_DAILY_MESSAGES=50
QUOTA_SESSION_TURNS=25
QUOTA_MESSAGE_MAX_LEN=500
QUOTA_PLAN_GENERATIONS=3

# --- 行为检测 ---
RATE_LIMIT_MSGS_PER_SEC=2
RATE_LIMIT_COOLDOWN_SEC=30
LONG_MSG_STREAK=3

# --- 全站兜底：每日 LLM 消耗硬顶（元），0=不限制 ---
GLOBAL_DAILY_COST_CAP=100
